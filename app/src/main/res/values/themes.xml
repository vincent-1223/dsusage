<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DSUsage" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/deepseek_blue</item>
        <item name="colorPrimaryVariant">@color/deepseek_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/deepseek_blue</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorAccent">@color/deepseek_blue</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="TextKicker">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextMetricLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <style name="TextMetricValue">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="WidgetLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WidgetValue">
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>

